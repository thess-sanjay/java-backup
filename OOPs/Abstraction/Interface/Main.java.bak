interface Vehicle
{
	void stop();
}

class Car implements Vehicle
{
	public void stop()
	{
		@Override
			
		System.out.println("Car has Stopped");
	}
}


class Main 
{
	public static void main(String[] args) 
	{
		Car c = new Car();
		c.stop();
		
		Vehicle v = new Car();
		v.stop();
	}
}
