class NumRepeatPattern 
{
	public static void main(String[] args) 
	{
		int n = 8;
		int count = 1;
		
		for(int i=1; i<=n; i++)
		{
			if(i <= 5)
			{
				count = i;
			}
			else
			{
				count--;	
			}
			
			for(int j=1; j<=count; j++)
			{
				System.out.print(j);
			}
			System.out.println();
	}
		}
		
}
